# Copy to /etc/cowrie-dashboard.env (root-owned, mode 600). Never commit the real file.
# Plain KEY=value lines: no quotes, no spaces around "=", no "export".

# Required. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Where the user database lives (folder owned by the service user, mode 700)
DATABASE=/var/lib/cowrie-dashboard/users.db

# 1 once HTTPS works. 0 only for local testing over plain HTTP.
COOKIE_SECURE=1

# Cowrie logs and the country database
COWRIE_LOG_DIR=/home/cowrie/cowrie/var/log/cowrie
GEOIP_DB=/var/lib/cowrie-dashboard/dbip-country-lite.mmdb

# Optional: invite-only signup page. Leave empty to disable (/signup returns 404).
SIGNUP_CODE=

# Optional: Google sign-in. Leave the first two empty to disable it.
# When enabled, GOOGLE_ALLOWED_EMAILS is REQUIRED (comma-separated, verified emails only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=you@example.com
GOOGLE_REDIRECT_URI=https://dash.example.com/auth/google/callback
