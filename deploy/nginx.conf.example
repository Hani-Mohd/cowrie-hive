# /etc/nginx/sites-available/cowrie-dashboard  (replace dash.example.com)
limit_req_zone $binary_remote_addr zone=dash:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

# Port 80: certificate validation + redirect to HTTPS
server {
    listen 80;
    server_name dash.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 443: the dashboard
server {
    listen 443 ssl;
    server_name dash.example.com;

    ssl_certificate     /etc/letsencrypt/live/dash.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dash.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Keep this short until certificate renewal is proven to work
    add_header Strict-Transport-Security "max-age=300" always;
    gzip_types image/svg+xml text/css application/javascript application/json;

    # Optional: restrict to your own IP
    #allow YOUR_IP;
    #deny all;

    location = /login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append: stops spoofing
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=dash burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
